<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bauty Log" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bauty Log">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="app-header">
      <div class="app-header-overlay">
        <%= link_to "ビューティーログ", root_path, class: "app-header-title" %>
        <nav>
          <%= link_to "施術記録", treatments_path %>
          <%= link_to "サロン管理", salons_path %>
        </nav>
      </div>
    </header>
    <%= yield %>
  </body>
</html>
