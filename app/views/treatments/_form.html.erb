<%= form_with(model: treatment) do |form| %>
  <% if treatment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(treatment.errors.count, "error") %> prohibited this treatment from being saved:</h2>

      <ul>
        <% treatment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :category, style: "display: block" %>
    <%= form.number_field :category %>
  </div>

  <div>
    <%= form.label :treatment_date, style: "display: block" %>
    <%= form.date_field :treatment_date %>
  </div>

  <div>
    <%= form.label :next_due_date, style: "display: block" %>
    <%= form.date_field :next_due_date %>
  </div>

  <div>
    <%= form.label :price, style: "display: block" %>
    <%= form.number_field :price %>
  </div>

  <div>
    <%= form.label :memo, style: "display: block" %>
    <%= form.textarea :memo %>
  </div>

  <div>
    <%= form.label :salon_id, style: "display: block" %>
    <%= form.text_field :salon_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
