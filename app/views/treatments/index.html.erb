<p style="color: green"><%= notice %></p>

<% content_for :title, "Treatments" %>

<h1>Treatments</h1>

<div id="treatments">
  <% @treatments.each do |treatment| %>
    <%= render treatment %>
    <p>
      <%= link_to "Show this treatment", treatment %>
    </p>
  <% end %>
</div>

<%= link_to "New treatment", new_treatment_path %>
