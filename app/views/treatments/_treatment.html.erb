<div id="<%= dom_id treatment %>" style="border: 1px solid #F7D9E4; border-radius: 12px; padding: 12px; margin-bottom: 12px;">
  <% if treatment.photo.attached? %>
    <%= image_tag treatment.photo, style: "max-width: 150px; display: block; margin-bottom: 8px;" %>
  <% end %>
  <div>
    <strong>カテゴリ:</strong>
    <%= treatment.category_label %>
  </div>
  <div>
    <strong>施術日:</strong>
    <%= treatment.treatment_date %>
  </div>
  <div>
    <strong>次回目安日:</strong>
    <%= treatment.next_due_date %>
  </div>
  <div>
    <strong>金額:</strong>
    <%= treatment.price %>円
  </div>
  <div>
    <strong>メモ:</strong>
    <%= treatment.memo %>
  </div>
  <div>
    <strong>サロン:</strong>
    <%= treatment.salon&.name %>
  </div>
</div>
