<div id="<%= dom_id treatment %>">
  <div>
    <strong>Category:</strong>
    <%= treatment.category %>
  </div>

  <div>
    <strong>Treatment date:</strong>
    <%= treatment.treatment_date %>
  </div>

  <div>
    <strong>Next due date:</strong>
    <%= treatment.next_due_date %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= treatment.price %>
  </div>

  <div>
    <strong>Memo:</strong>
    <%= treatment.memo %>
  </div>

  <div>
    <strong>Salon:</strong>
    <%= treatment.salon_id %>
  </div>

</div>
