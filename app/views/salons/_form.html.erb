<%= form_with(model: salon) do |form| %>
  <% if salon.errors.any? %>
    <div style="color: #D9536F; background: #FFF0F4; border-radius: 12px; padding: 12px 16px;">
      <h2 style="margin-top: 0;"><%= pluralize(salon.errors.count, "件") %>のエラーがあります:</h2>
      <ul>
        <% salon.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, "サロン名", style: "display: block" %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :area, "エリア", style: "display: block" %>
    <%= form.text_field :area %>
  </div>
  <div>
    <%= form.label :phone_number, "電話番号", style: "display: block" %>
    <%= form.text_field :phone_number %>
  </div>
  <div>
    <%= form.submit "保存する" %>
  </div>
<% end %>
